  "stories": [
    {
      "id": "dragon",
      "x": 50,
      "z": 0,
      "r": 12,
      "title": {
        "vi": "Cầu Rồng",
        "en": "Dragon Bridge"
      },
      "text": {
        "vi": "Cầu Rồng khánh thành ngày 29 tháng 3 năm 2013, đúng dịp kỷ niệm ngày giải phóng Đà Nẵng. Cầu dài 666 mét, thân rồng bằng thép uốn lượn trên mặt cầu, đầu rồng hướng ra biển Đông. Về đêm, hàng nghìn bóng LED đổi màu liên tục. Tối thứ Bảy, Chủ nhật và dịp lễ, khoảng 9 giờ tối, rồng phun lửa rồi phun nước, người đứng gần đầu rồng sẽ bị hơi nước bay vào mặt.",
        "en": "Opened on 29 March 2013, the 666-metre Dragon Bridge carries a steel dragon whose head faces the East Sea. At around 9pm on Saturdays, Sundays and holidays it breathes fire, then water."
      }
    },
    {
      "id": "love",
      "x": 44,
      "z": -71,
      "r": 10,
      "title": {
        "vi": "Cầu Tình Yêu",
        "en": "Love Pier"
      },
      "text": {
        "vi": "Cầu tàu nhỏ bên bờ đông sông Hàn, lan can treo kín ổ khóa của các cặp đôi, buổi tối thắp đèn hình trái tim màu đỏ. Ở đây bạn có thể treo một ổ khóa kèm lời nhắn, người khác đi ngang qua sẽ đọc được.",
        "en": "A small pier on the east bank where couples hang padlocks. Here you can hang a lock with a note that others can read."
      }
    },
    {
      "id": "carp",
      "x": 25,
      "z": -71,
      "r": 10,
      "title": {
        "vi": "Cá chép hóa rồng",
        "en": "Carp becoming dragon"
      },
      "text": {
        "vi": "Tượng cá chép hóa rồng phun nước nhìn sang Cầu Rồng, gợi tích cá chép vượt Vũ Môn hóa rồng, ý chỉ sự vươn lên và thành đạt.",
        "en": "The fountain statue recalls the legend of the carp that leaps the Dragon Gate and becomes a dragon."
      }
    },
    {
      "id": "hanbridge",
      "x": 70,
      "z": -630,
      "r": 22,
      "title": {
        "vi": "Cầu Sông Hàn",
        "en": "Han River Bridge"
      },
      "text": {
        "vi": "Phía bắc là Cầu Sông Hàn, khánh thành năm 2000, cây cầu quay đầu tiên của Việt Nam. Sau nửa đêm, nhịp giữa cầu quay ngang để tàu thuyền đi qua.",
        "en": "To the north is the Han River Bridge (2000), Vietnam's first swing bridge, which rotates after midnight to let ships pass."
      }
    },
    {
      "id": "tranthily",
      "x": 70,
      "z": 1030,
      "r": 22,
      "title": {
        "vi": "Cầu Trần Thị Lý",
        "en": "Tran Thi Ly Bridge"
      },
      "text": {
        "vi": "Phía nam là cầu dây văng Trần Thị Lý, trụ tháp nghiêng như một cánh buồm trắng, buổi tối được chiếu sáng nổi bật trên nền trời.",
        "en": "To the south, the cable-stayed Tran Thi Ly Bridge with its sail-shaped pylon."
