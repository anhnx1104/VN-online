  "stories": [
    {
      "id": "mykhe",
      "x": -30,
      "z": 20,
      "r": 14,
      "title": {
        "vi": "Biển Mỹ Khê",
        "en": "My Khe Beach"
      },
      "text": {
        "vi": "Mỹ Khê là bãi biển dài nhiều cây số chạy dọc đường Võ Nguyên Giáp, cát trắng mịn, sóng êm phần lớn thời gian trong năm. Năm 2005, tạp chí Forbes của Mỹ đưa Mỹ Khê vào danh sách những bãi biển quyến rũ nhất hành tinh. Bờ biển quay về hướng đông, nên sáng sớm ở đây mặt trời mọc thẳng từ mặt biển.",
        "en": "My Khe stretches for kilometres along Vo Nguyen Giap street. It faces east, so the sun rises straight out of the sea."
      }
    },
    {
      "id": "thungchai",
      "x": 44,
      "z": -150,
      "r": 12,
      "title": {
        "vi": "Thúng chai",
        "en": "Basket boats"
      },
      "text": {
        "vi": "Thúng chai là chiếc thuyền tròn đan bằng tre, trét dầu rái cho kín nước. Ngư dân dùng thúng để chèo ra thuyền lớn và chở cá vào bờ. Người chèo lắc mái chèo sang hai bên, thúng vừa xoay vừa tiến lên.",
        "en": "Round bamboo basket boats, sealed with resin, used by fishermen to reach their larger boats."
      }
    },
    {
      "id": "sontra",
      "x": 40,
      "z": -300,
      "r": 22,
      "title": {
        "vi": "Bán đảo Sơn Trà",
        "en": "Son Tra Peninsula"
      },
      "text": {
        "vi": "Phía bắc là bán đảo Sơn Trà. Trên sườn núi có chùa Linh Ứng Bãi Bụt với tượng Quan Âm cao khoảng 67 mét nhìn ra biển. Khu này sắp mở, bạn có thể bình chọn trong mục Đi đâu.",
        "en": "To the north lies Son Tra Peninsula with Linh Ung Pagoda and its tall Lady Buddha statue."
      }
    }
  ]
